---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import HomeHero from "../components/home/HomeHero.astro";
import RecentPosts from "../components/home/RecentPosts.astro";
import FeaturedExperiment from "../components/home/FeaturedExperiment.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);
const experiments = (await getCollection("experiments", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = experiments[0];
---

<BaseLayout title="首页" description="个人技术研究、工程实践与学习笔记" wide hideGitHubLink>
  <HomeHero />
  <RecentPosts posts={posts} />
  {featured && <FeaturedExperiment experiment={featured} />}
</BaseLayout>
