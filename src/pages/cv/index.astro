---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import Info from "../../components/Info.astro";
import "github-markdown-css/github-markdown-light.css";

const [profiles, summaries, jobs, projects, education, certifications] = await Promise.all([
  getCollection("cv"),
  getCollection("summary"),
  getCollection("work"),
  getCollection("projects"),
  getCollection("education"),
  getCollection("certifications"),
]);

const entries = [
  ...summaries.map(entry => ({ entry, section: "summary", heading: "", subtitle: "" })),
  ...jobs.map(entry => ({
    entry,
    section: entry.data.section ?? "work",
    heading: entry.data.company,
    subtitle: `${entry.data.title} · ${entry.data.periodLabel ?? entry.data.period.raw}`,
  })),
  ...projects.map(entry => ({
    entry,
    section: "projects",
    heading: entry.data.title,
    subtitle: [entry.data.role, entry.data.period].filter(Boolean).join(" · "),
  })),
  ...education.map(entry => ({ entry, section: "education", heading: "", subtitle: "" })),
  ...certifications.map(entry => ({ entry, section: "certifications", heading: "", subtitle: "" })),
];

const resumes = await Promise.all(
  profiles
    .sort((a, b) => a.id.localeCompare(b.id))
    .map(async profile => {
      const localized = await Promise.all(entries
        .filter(({ entry }) => entry.data.lang === profile.id)
        .sort((a, b) => (a.entry.data.sectionOrder ?? 0) - (b.entry.data.sectionOrder ?? 0)
          || (("order" in a.entry.data ? a.entry.data.order : 0) - ("order" in b.entry.data ? b.entry.data.order : 0)))
        .map(async item => ({ ...item, ...(await render(item.entry)) })));
      const sections = [...new Set(localized.map(item => item.section))].map(key => ({
        key,
        title: localized.find(item => item.section === key)?.entry.data.sectionTitle,
        items: localized.filter(item => item.section === key),
      }));
      return {
        ...profile,
        ...(await render(profile)),
        sections,
        linkedContacts: profile.data.contacts.filter(contact => contact.url),
        pendingContacts: profile.data.contacts.filter(contact => !contact.url && contact.placeholder),
      };
    }),
);
---

<BaseLayout title="简历 / CV" hideGitHubLink>
  <div class="resume" data-resume>
    <div class="resume__toolbar" role="group" aria-label="简历语言 / Resume language">
      <button type="button" data-language="zh" aria-controls="resume-zh" aria-pressed="true">中文</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-language="en" aria-controls="resume-en" aria-pressed="false">English</button>
    </div>
    <noscript><p>语言切换需要 JavaScript。/ Enable JavaScript to switch languages.</p></noscript>
    {resumes.map(({ id, data, Content, sections, linkedContacts, pendingContacts }) => (
      <article id={`resume-${id}`} class="markdown-body" lang={id === "zh" ? "zh-CN" : "en"} hidden={id !== "zh"}>
        <header class="resume__header">
          <h1>{data.name}</h1>
          <p class="resume__title">{data.title}</p>
          <address>
            <Info href={`tel:${data.phone}`} iconName="device-mobile">{data.phone}</Info>
            <Info href={`mailto:${data.email}`} iconName="mail">{data.email}</Info>
            {linkedContacts.map(contact => (
              contact.label.toLowerCase() === "github" ? (
                <Info href={contact.url!} iconName="mark-github">{contact.label}</Info>
              ) : contact.label.toLowerCase() === "linkedin" ? (
                <Info href={contact.url!} iconName="linkedin">{contact.label}</Info>
              ) : (
                <a href={contact.url}>{contact.label}</a>
              )
            ))}
          </address>
          {pendingContacts.length > 0 && (
            <aside class="resume__notice">
              <ul>
                {pendingContacts.map(contact => (
                  <li>{contact.label}: {contact.placeholder}</li>
                ))}
              </ul>
            </aside>
          )}
        </header>
        <Content />
        {sections.map(section => (
          <section data-section={section.key}>
            <h2>{section.title}</h2>
            {section.items.map(({ heading, subtitle, Content: EntryContent }) => (
              <div class="resume__entry">
                {heading && <h3>{heading}</h3>}
                {subtitle && <p><strong>{subtitle}</strong></p>}
                <EntryContent />
              </div>
            ))}
          </section>
        ))}
      </article>
    ))}
  </div>
</BaseLayout>

<script>
  const resume = document.querySelector<HTMLElement>("[data-resume]");
  if (resume) {
    const buttons = resume.querySelectorAll<HTMLButtonElement>("[data-language]");
    const articles = resume.querySelectorAll<HTMLElement>("article[lang]");
    const selectLanguage = (language: string) => {
      const selected = language === "en" ? "en" : "zh";
      for (const article of articles) article.hidden = article.id !== `resume-${selected}`;
      for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.language === selected));
    };
    selectLanguage(new URL(window.location.href).searchParams.get("lang") ?? "zh");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const language = button.dataset.language ?? "zh";
        selectLanguage(language);
        const url = new URL(window.location.href);
        url.searchParams.set("lang", language);
        window.history.pushState(null, "", url);
      });
    }
    window.addEventListener("popstate", () => selectLanguage(new URL(window.location.href).searchParams.get("lang") ?? "zh"));
  }
</script>

<style>
  .resume { max-width: 7in; margin-inline: auto; }
  .resume__toolbar { display: flex; justify-content: flex-end; align-items: center; gap: 0.6rem; margin-bottom: 2rem; }
  button { border: 1px solid var(--border); border-radius: 5px; padding: 0.4rem 0.8rem; background: white; color: var(--muted); font: inherit; cursor: pointer; }
  button[aria-pressed="true"] { background: var(--link); border-color: var(--link); color: white; }
  button:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
  .markdown-body { font-size: 15px; line-height: 1.8; overflow-wrap: anywhere; }
  .markdown-body[hidden] { display: none; }
  .resume__header h1 { text-align: center; margin-top: 0; margin-bottom: 0.25em; }
  .resume__title { text-align: center; color: var(--muted); }
  address { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 2rem; font-style: normal; }
  .resume__notice { margin-block: 1.5rem; padding: 1rem; border: 2px solid #b45309; border-radius: 6px; background: #fffbeb; color: #78350f; font-size: 0.875rem; }
  .resume__notice ul { margin-bottom: 0; }
  .markdown-body :global(h2) { margin-top: 2rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border); }
  .markdown-body :global(h3) { margin-top: 1.5rem; }
  .markdown-body :global(a) { text-decoration: underline; }
  @media (max-width: 600px) {
    .markdown-body { font-size: 14px; }
    address { flex-direction: column; align-items: center; }
  }
  @media print {
    @page { margin: 0.5in; }
    .resume__toolbar { display: none; }
    .markdown-body { font-size: 10pt; }
    .markdown-body :global(h2), .markdown-body :global(h3) { break-after: avoid; }
    .resume__header { break-inside: avoid; }
  }
</style>
