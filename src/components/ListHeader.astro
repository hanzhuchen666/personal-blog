---
interface Props { title: string; }
const { title } = Astro.props;
---

<header class="list-header">
  <h1>{title}</h1>
</header>

<style>
  .list-header { position: relative; isolation: isolate; padding-block: 44px 38px; margin-bottom: 32px; border-bottom: 1px solid #e3e7e9; }
  .list-header::before {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: -48px calc((1040px - 100vw) / 2) 0;
    background-image: linear-gradient(to right, #4f4f4f2e 1px, transparent 1px), linear-gradient(to bottom, #4f4f4f2e 1px, transparent 1px);
    background-size: 14px 24px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 50%, transparent 110%);
    opacity: 0.42;
  }
  h1 { margin: 0; color: #1f252b; font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1.3; }
  @media (max-width: 1080px) { .list-header::before { inset-inline: -20px; } }
  @media (max-width: 600px) {
    .list-header { padding-block: 28px 30px; margin-bottom: 26px; }
    .list-header::before { top: -32px; }
  }
</style>
