---
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  hideGitHubLink?: boolean;
  wide?: boolean;
}

const {
  title,
  hideGitHubLink = false,
  wide = false,
  description = "技术研究与工程笔记",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />

    <title>{title} | Code & Math </title>
  </head>

  <body>
    <header class="site-header">
      <div class:list={["container", "header-inner", { "layout-wide": wide }]}>
        <a class="site-name" href="/">
          Code & Math
        </a>

        <nav aria-label="主导航">
          <a href="/">首页</a>
          <a href="/cv/">简历</a>
          <a href="/notes/">笔记</a>
          <a href="/experiments/">实验</a>
          <a href="/about/">关于</a>
        </nav>
      </div>
    </header>

    <main class:list={["container", { "layout-wide": wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class:list={["container", { "layout-wide": wide }]}>
        <span>Code & Math</span>
        {!hideGitHubLink && <a href="https://github.com/">GitHub</a>}
      </div>
    </footer>
  </body>
</html>

<style>
  .layout-wide { --content-width: 1040px; }
</style>
